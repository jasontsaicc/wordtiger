{
  "name": "wordtiger",
  "version": "1.4.0",
  "description": "攔詞虎：標出生詞、AI 查詞與拆句的英文閱讀助手",
  "main": "index.js",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:safari": "tsx scripts/build-freq.ts && wxt build -b safari --mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "prebuild": "tsx scripts/build-freq.ts",
    "predev": "tsx scripts/build-freq.ts",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "keywords": [],
  "author": "JasonDevOps",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "subtlex-word-frequencies": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "dexie": "^4.4.5"
  }
}
